# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (Homebrew Postgres). In Docker Compose the host is `postgres`.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/household_budget_dev?schema=public"
# Used only by integration tests. MUST be a throwaway database: tests truncate it.
TEST_DATABASE_URL="postgresql://postgres:change-me@localhost:5432/household_budget_test?schema=public"

# Credentials for the Postgres container created by docker-compose.yml. These
# are the cluster superuser's.
POSTGRES_USER="postgres"
# Leave empty. Generated on first boot, like the secrets above.
POSTGRES_PASSWORD=""
POSTGRES_DB="household_budget"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Shown in the sidebar. Set it to whatever you like — it stays in .env, so a
# household name never reaches the repository.
APP_NAME="Delegate"
NODE_ENV="development"
# Port the API listens on inside the container.
PORT="3000"
# Port the application publishes on the host. Change it if something already
# uses this one — on a Synology, DSM holds 80 and 443, which is why the default
# is not either of those.
HOST_PORT="8088"

# ---------------------------------------------------------------------------
# HTTPS, for a deployment that has a domain name
# ---------------------------------------------------------------------------
# Set this and start with the `https` profile to get a real certificate:
#
#   DELEGATE_DOMAIN=budget.example.com docker compose --profile https up -d
#
# Caddy then requests one from Let's Encrypt on first start, renews it on its
# own, and redirects http to https. Ports 80 and 443 have to be reachable from
# the internet for the certificate to be issued at all.
#
# Leave it empty on a LAN, or behind a tunnel that terminates TLS itself. Plain
# http at the origin is correct in both (ADR 017) and is what the default does.
DELEGATE_DOMAIN=""
# Where Caddy publishes, when the profile is on. Only change these if something
# else on the machine already holds 80 and 443.
HTTP_PORT="80"
HTTPS_PORT="443"
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# Leave empty. Generated on first boot into the secrets volume, along with the
# at-rest encryption key and the database password — which is what makes
# `docker compose up -d` work with no configuration at all.
#
# Set it only if you manage secrets yourself; a value here is adopted rather
# than replaced, and never rotated under you.
#
# It signs session cookies and nothing else now. The key that encrypts stored
# secrets used to be derived from this (ADR 029) and is recorded separately from
# the first boot, so this can be rotated on suspicion without making anything at
# rest unreadable.
SESSION_SECRET=""
# Session idle expiry in seconds. Default 7 days. Rolling: every response
# pushes it out, so this bounds inactivity and nothing else.
SESSION_TTL_SECONDS="604800"
# The ceiling a rolling session cannot roll past, in seconds. Default 90 days.
# Measured from when the session was created and never extended — without it, a
# session that keeps being used never expires at all.
SESSION_ABSOLUTE_TTL_SECONDS="7776000"
# Set to true only when the app is really served over TLS. Plain http at the
# origin is the permanent default (ADR 017); over plain http a Secure cookie is
# never sent and login silently fails.
SESSION_COOKIE_SECURE="false"

# Whether to believe X-Forwarded-For, and from whom. Empty means the connecting
# socket is the client, which is right when nothing sits in front.
#
# Set this when reaching Delegate through a Cloudflare Tunnel or any other
# proxy: without it every request appears to come from the proxy, and the
# sign-in rate limit becomes one shared bucket for the whole internet.
#
# Accepts "true", or a comma-separated list of addresses and CIDR ranges.
#
# Only correct when the app CANNOT be reached except through that proxy. If the
# port is also open on the LAN, anyone can forge the header and get a fresh
# rate-limit bucket per request. Confine the port first. See ADR 018.
# **Set this when you use the `https` profile**, or any other reverse proxy.
# 172.16.0.0/12 covers Docker's default networks and is right for the bundled
# Caddy. The application warns at boot when a forwarded header arrives and this
# is empty, because that is the state where the rate limit quietly stops working.
TRUST_PROXY=""

# Optional TLS, terminated by the application itself. Empty means plain http,
# which is the documented default for a trusted LAN — see ADR 017. Delegate does
# not need a secure context for anything it does; what TLS buys is that passwords
# and two-factor codes stop crossing the network in the clear.
#
# To turn it on:
#   ./scripts/make-tls-cert.sh 10.0.3.4 nas.local
# then set both paths below (they are container paths — the host directory in
# TLS_DIR is mounted at /tls) and SESSION_COOKIE_SECURE="true".
#
# Both or neither: the app refuses to start with half a TLS configuration.
# Every device will warn until the certificate is trusted on it.
TLS_DIR="./tls"
TLS_CERT_PATH=""
TLS_KEY_PATH=""

# Extra origins allowed to make state-changing requests, comma separated —
# for example "https://budget.example". The server's own Host always counts, so
# a direct LAN deployment needs nothing here. Set this only when a reverse proxy
# presents the app under a different name than the origin server sees, or every
# save is refused with cross_origin_refused. See ADR 015.
TRUSTED_ORIGINS=""

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Attempts allowed per address per window on the routes that verify a
# credential: sign-in, first-run setup, and changing a password. Ten in five
# minutes is generous for a household and useless for a guessing loop. Nothing
# throttled these before Phase 3, which is the strongest single reason this
# application stayed on the LAN.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW="5 minutes"

# ---------------------------------------------------------------------------
# SimpleFIN
# ---------------------------------------------------------------------------
# The long-lived access URL obtained by claiming a SimpleFIN setup token.
# Contains embedded credentials — never commit a real value.
#
# Optional. Connecting through Settings stores an encrypted credential in the
# database instead, which takes precedence over this. Leave it empty and use the
# UI unless you specifically want configuration-managed deployment.
SIMPLEFIN_ACCESS_URL=""
# Cron expression for the sync job. Default: hourly, on the hour.
SIMPLEFIN_SYNC_CRON="0 * * * *"
# Months of history requested on first sync.
SIMPLEFIN_BACKFILL_MONTHS="12"

# ---------------------------------------------------------------------------
# When scheduled jobs run
# ---------------------------------------------------------------------------
# The household's time zone, as an IANA name. Every cron expression in this file
# is read in it, and — since ADR 037 — so is every question of the form "which
# day did this happen on": which month a spend lands in, which day a price is the
# close for, where a chart's window starts.
#
# The process clock is still untouched. This is a stored setting the domain
# consults, not `TZ`.
#
# Defaults to UTC, which is what every deployment did before this setting
# existed. Set it to the household's zone: SCHEDULE_TIMEZONE="America/Chicago".
# Left on UTC in a zone that is not UTC, an 8pm charge is counted in the next
# day — and, at a month boundary, in the next month's utility average.
#
# The name is narrower than the meaning now is. It is kept because renaming it
# would silently revert a deployment to UTC the first time it booted without the
# new name, and that class of quiet failure has cost this project more than a
# slightly narrow name will.
#
# This is the **fallback** now, not the only way to set it. Settings → Budget
# offers a zone picker, and a zone chosen there wins over this value (ADR 036).
# This stays because the container has it before it can reach the database, and
# a first boot against an empty schema still has to know when to run. Null in
# the database — nobody has chosen — means "use this", which is why an existing
# deployment keeps firing exactly where it always did.
#
# One thing to know before choosing 02:00–02:59 in a zone that observes daylight
# saving: on the spring-forward morning that hour does not exist locally, so a
# job scheduled inside it can be skipped for that one night. 03:30 avoids it in
# both directions — 01:00–01:59 does not, because that hour happens twice in
# the autumn.
SCHEDULE_TIMEZONE="UTC"

# ---------------------------------------------------------------------------
# Bitcoin price feed (Phase 2). Keyless public endpoints only.
# ---------------------------------------------------------------------------
BITCOIN_PRICE_CRON="5 * * * *"
BITCOIN_PRICE_PRIMARY="coingecko"
BITCOIN_PRICE_FALLBACK="coinbase"

# ---------------------------------------------------------------------------
# Nightly snapshot
# ---------------------------------------------------------------------------
# The nightly snapshot of the whole financial picture (ADR 035), read in
# SCHEDULE_TIMEZONE like every other schedule here.
#
# 03:10 for three reasons. Off the hour, so it does not contend with the hourly
# sync on a two-core machine — the same reason the price fetch sits at :05.
# After that price fetch, which settles the previous day's Bitcoin close on its
# way through, so the snapshot has a real close to value a holding at rather
# than a carried one. And outside 02:00-02:59, the hour that does not exist
# locally on the spring-forward morning.
SNAPSHOT_CRON="10 3 * * *"

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Host directory mounted into the container for nightly pg_dump output. On the
# NAS this must be a shared folder that your off-device backup already covers —
# a dump on the same disk as the database is not a backup.
#
# Also shown on Settings → Sync, so the card names a path you can act on rather
# than `/backups`, which is only meaningful inside the container.
BACKUP_DIR="./backups"
BACKUP_CRON="30 2 * * *"
BACKUP_RETENTION_DAYS="30"

# The published image. CI builds it on x86_64 so it runs on an Intel Synology.
APP_IMAGE="ghcr.io/aso42244/delegate:latest"

# Reaching a Bitcoin node over Tor. Only used when the node setting asks for it,
# and the default points at the bundled `tor` compose service, which runs by
# default. (It was behind a profile at first, which meant pasting an onion
# address did nothing until you had also read the deployment notes.)
TOR_SOCKS_URL=socks5h://tor:9050

# A least-privilege database role for the application, instead of the superuser.
#
# Two variables, read by different containers at different moments. This pair
# *creates* the role, and only when Postgres initialises an empty data directory
# — so it affects a fresh install and never an existing one. Leave
# APP_DB_PASSWORD empty to stay on the superuser, which is what every deployment
# made before this existed does.
APP_DB_USER=delegate_app
APP_DB_PASSWORD=

# And this is what *connects* as it. Until this variable existed the application
# built its URL from POSTGRES_USER no matter what, so on a fresh install the role
# above was created and then never used — the feature did nothing.
#
# Empty means the superuser, unchanged. To move over — new install or existing —
# set it to the same role and password:
#   APP_DATABASE_URL=postgresql://delegate_app:<password>@postgres:5432/delegate
#
# Check what compose resolved before restarting anything:
#   sudo -i sh -c 'cd /volume1/docker/delegate && docker compose config' | grep DATABASE_URL
APP_DATABASE_URL=

# The key protecting secrets at rest — TOTP secrets, the SimpleFIN credential,
# wallet descriptors. Empty derives it from SESSION_SECRET, which is what every
# deployment did before this existed and must keep doing unless the data is
# re-encrypted. Moving onto a separate key is `npm run secrets:rekey`; see the
# README. Setting this without running that makes the stored secrets unreadable.
DATA_ENCRYPTION_KEY=
