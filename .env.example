# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (Homebrew Postgres). In Docker Compose the host is `postgres`.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/household_budget_dev?schema=public"
# Used only by integration tests. MUST be a throwaway database: tests truncate it.
TEST_DATABASE_URL="postgresql://postgres:change-me@localhost:5432/household_budget_test?schema=public"

# Credentials for the Postgres container created by docker-compose.yml.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="household_budget"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Shown in the sidebar. Set it to whatever you like — it stays in .env, so a
# household name never reaches the repository.
APP_NAME="Delegate"
NODE_ENV="development"
# Port the API listens on inside the container.
PORT="3000"
# Port published on the Synology host. Chosen to avoid colliding with the
# existing Sure container; change if this port is already in use.
HOST_PORT="8088"
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
#
# Also the key that encrypts the stored SimpleFIN credential, so CHANGING IT
# means reconnecting SimpleFIN in Settings. That is a one-minute job, not data
# loss, but it is not obvious from the variable name. See ADR 011.
SESSION_SECRET=""
# Session idle expiry in seconds. Default 7 days.
SESSION_TTL_SECONDS="604800"
# Set to true only once the app is served over TLS (Phase 3). Over plain http
# on the LAN a Secure cookie is never sent and login silently fails.
SESSION_COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Rate limiting (Phase 3)
# ---------------------------------------------------------------------------
# Attempts allowed per address per window on the routes that verify a
# credential: sign-in, first-run setup, and changing a password. Ten in five
# minutes is generous for a household and useless for a guessing loop. Nothing
# throttled these before Phase 3, which is the strongest single reason this
# application stayed on the LAN.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW="5 minutes"

# ---------------------------------------------------------------------------
# SimpleFIN
# ---------------------------------------------------------------------------
# The long-lived access URL obtained by claiming a SimpleFIN setup token.
# Contains embedded credentials — never commit a real value.
#
# Optional. Connecting through Settings stores an encrypted credential in the
# database instead, which takes precedence over this. Leave it empty and use the
# UI unless you specifically want configuration-managed deployment.
SIMPLEFIN_ACCESS_URL=""
# Cron expression for the sync job. Default: hourly, on the hour.
SIMPLEFIN_SYNC_CRON="0 * * * *"
# Months of history requested on first sync.
SIMPLEFIN_BACKFILL_MONTHS="12"

# ---------------------------------------------------------------------------
# Bitcoin price feed (Phase 2). Keyless public endpoints only.
# ---------------------------------------------------------------------------
BITCOIN_PRICE_CRON="5 * * * *"
BITCOIN_PRICE_PRIMARY="coingecko"
BITCOIN_PRICE_FALLBACK="coinbase"

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Host directory mounted into the container for nightly pg_dump output.
# Host directory mounted into the container for nightly pg_dump output. On the
# NAS this must be a shared folder that your off-device backup already covers —
# a dump on the same disk as the database is not a backup.
BACKUP_DIR="./backups"
BACKUP_CRON="30 2 * * *"
BACKUP_RETENTION_DAYS="30"

# The published image. CI builds it on x86_64 so it runs on an Intel Synology.
APP_IMAGE="ghcr.io/aso42244/delegate:latest"
